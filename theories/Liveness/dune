; (include_subdirs qualified) from absorbing this directory, as for Common/.
(include_subdirs qualified)

(rocq.theory
 (name LinuxProcessSemantics.Liveness)
 (package rocq-linux-process-semantics-liveness)
 ; dune does not know the dependencies of an installed theory, so the
 ; transitive ones of CTreeModel, Examples and TICL are listed too.
