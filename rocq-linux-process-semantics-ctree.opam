opam-version: "2.0"
name: "rocq-linux-process-semantics-ctree"
version: "dev"
synopsis: "Choice-tree model of rocq-linux-process-semantics, a refinement of Run.run"
description: """
The Rocq theory LinuxProcessSemantics.CTreeModel: the process model of
rocq-linux-process-semantics-core written as a choice tree (vellvm/ctrees),
with a proof that its finite observable behavior refines Run.run's (equal
traces; errors of the tree are errors of the run), that the run's blocking
syscall declines are divergences of the tree, and that the two coincide on
runs reaching no blocking call.
"""
maintainer: "Theorem Labs"
authors: ["Theorem Labs"]
license: "MIT"
homepage: "https://github.com/theorem-labs/rocq-linux-process-semantics"
bug-reports: "https://github.com/theorem-labs/rocq-linux-process-semantics/issues"
dev-repo: "git+https://github.com/theorem-labs/rocq-linux-process-semantics.git"
depends: [
  "dune" {>= "3.23"}
  "rocq-core" {>= "9.2"}
  "rocq-stdlib" {>= "9.0"}
  "rocq-stdpp" {>= "1.13.0"}
  "rocq-stdpp-bitvector" {>= "1.13.0"}
  "coq-flocq" {>= "4.2"}
  # rocq-read-file 0.0.2 does not build with dune 3.24 or later (which
  # Rocq 9.3 and later select); 0.0.3 does.
  ("rocq-read-file" {>= "0.0.3"} | ("rocq-read-file" {= "0.0.2"} & "dune" {< "3.24"}))
  "rocq-linux-process-semantics-core" {= version}
  # Not on opam, and its repository commits no .opam file.  Pin it first:
  #   git clone -b fix/universe-check https://github.com/vellvm/ctrees.git
  #   cd ctrees && dune build rocq-ctree.opam && cp _build/default/rocq-ctree.opam .
  #   opam pin add -y -k path rocq-ctree .
  "rocq-ctree"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
